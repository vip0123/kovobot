{
  // Server code: the API and the shared packages. Node 24 runs these .ts files
  // directly by stripping types, so nothing is emitted and only erasable
  // TypeScript syntax is allowed. The web app has its own tsconfig.
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["apps/api", "packages", "vitest.config.ts", "test"]
}
